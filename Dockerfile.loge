# syntax=docker/dockerfile:1
#
# loge image (agent-runtime ADR 0010 amendment 2026-07-07): the generic runtime + the agora
# channel plugin BAKED at build. A cold loge then boots with a `cp` instead of a ~14s
# `claude plugin install` — the plugin used to reinstall on EVERY ephemeral (emptyDir) HOME.
# Derived on purpose, so `agent-runtime` stays channel-agnostic (the manager runs the base, no
# channel); only this variant knows about agora.
#
# BASE is pinned by CI to the exact agent-runtime built from the same commit (digest) → the
# `claude plugin install` runs with the SAME claude that consumes it at runtime = zero version drift.
# CHANNEL is where agora already publishes its channel delivery copy (its own image, /opt/agora).

ARG BASE=ghcr.io/arnaultbretagne/agent-runtime:latest
ARG CHANNEL=ghcr.io/arnaultbretagne/agora-website:latest

FROM ${CHANNEL} AS channel

FROM ${BASE}
# The base has: claude in ~/.local, USER node, HOME=/home/node, and the managed-settings plugin
# allowlist baked at /etc/claude-code (that approval is what lets the install/consume succeed).
# Keep the channel's delivery copy in the image so the installed marketplace path resolves.
COPY --from=channel --chown=node:node /opt/agora /opt/agora
# Install once, at build. Then stash the install's durable output OUT of ~/.claude — the loge mounts
# an emptyDir on ~/.claude at runtime, which would hide anything baked under it; the seed
# initContainer restores it into the fresh HOME (sub-second) at boot. Two pieces matter: the plugin
# tree (~/.claude/plugins) AND settings.json — the latter carries `enabledPlugins`, which is what
# makes claude spawn the channel's MCP server (without it the plugin loads but the bridge never runs).
RUN claude plugin marketplace add /opt/agora \
 && claude plugin install agora@agora \
 && mkdir -p /home/node/agora-state \
 && mv /home/node/.claude/plugins /home/node/agora-state/plugins \
 && cp /home/node/.claude/settings.json /home/node/agora-state/settings.json
# claude REWRITES ~/.claude.json on every run — the install above stripped the base's baked
# onboarding/trust/bypass-acceptance flags (hasCompletedOnboarding, bypassPermissionsModeAccepted),
# so a runtime claude would hang on the interactive "Bypass Permissions mode" prompt. Restore the
# pristine seed. (Today's runtime-install loges dodge this only because the seed's mangling stays in
# a separate initContainer overlay; baking it into the image makes it durable, so restore it.)
COPY --chown=node:node image/claude.json.seed /home/node/.claude.json

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/index.js"]
