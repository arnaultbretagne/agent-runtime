# syntax=docker/dockerfile:1
#
# loge image (agent-runtime ADR 0010 amendment 2026-07-07): the generic runtime + the agora
# channel plugin BAKED at build. A cold loge then boots with a `cp` instead of a ~14s
# `claude plugin install` — the plugin used to reinstall on EVERY ephemeral (emptyDir) HOME.
# Derived on purpose, so `agent-runtime` stays channel-agnostic (the manager runs the base, no
# channel); only this variant knows about agora.
#
# BASE is pinned by CI to the exact agent-runtime built from the same commit (digest) → the
# `claude plugin install` runs with the SAME claude that consumes it at runtime = zero version drift.
# CHANNEL is where agora already publishes its channel delivery copy (its own image, /opt/agora).

ARG BASE=ghcr.io/arnaultbretagne/agent-runtime:latest
ARG CHANNEL=ghcr.io/arnaultbretagne/agora-website:latest

FROM ${CHANNEL} AS channel

FROM ${BASE}
# The base has: claude in ~/.local, USER node, HOME=/home/node, and the managed-settings plugin
# allowlist baked at /etc/claude-code (that approval is what lets the install/consume succeed).
# Keep the channel's delivery copy in the image so the installed marketplace path resolves.
COPY --from=channel --chown=node:node /opt/agora /opt/agora
# Install once, at build. Then stash the install's durable output OUT of ~/.claude — the loge mounts
# an emptyDir on ~/.claude at runtime, which would hide anything baked under it; the seed
# initContainer restores it into the fresh HOME (sub-second) at boot. Two pieces matter: the plugin
# tree (~/.claude/plugins) AND settings.json — the latter carries `enabledPlugins`, which is what
# makes claude spawn the channel's MCP server (without it the plugin loads but the bridge never runs).
RUN claude plugin marketplace add /opt/agora \
 && claude plugin install agora@agora \
 && mkdir -p /home/node/agora-state \
 && mv /home/node/.claude/plugins /home/node/agora-state/plugins \
 && cp /home/node/.claude/settings.json /home/node/agora-state/settings.json
# claude REWRITES ~/.claude.json on every run — the install above stripped the base's baked
# onboarding/trust/bypass-acceptance flags (hasCompletedOnboarding, bypassPermissionsModeAccepted),
# so a runtime claude would hang on the interactive "Bypass Permissions mode" prompt. Restore the
# pristine seed. (Today's runtime-install loges dodge this only because the seed's mangling stays in
# a separate initContainer overlay; baking it into the image makes it durable, so restore it.)
COPY --chown=node:node image/claude.json.seed /home/node/.claude.json

# --- GitHub access without a stored credential (agent-broker plan P6.4) --------------------------
# git's HTTPS client needs a real credential, so — unlike the vault, which the broker proxies — a
# GitHub token does enter the loge. It enters through here and nowhere else: a credential helper that
# asks the broker per call and answers git on a pipe. Nothing is stored, so nothing leaks into the
# session transcript, the PTY log, `.git/config`, or a remote URL.
#
# Root only to write outside /home/node; back to `node` immediately (skip-permissions needs non-root).
USER root
COPY --chmod=0755 image/git-credential-agent-broker /usr/local/bin/git-credential-agent-broker
# Two facts, both --system (/etc/gitconfig) rather than --global: they are properties of the image,
# not preferences of a user.
#
# 1. The helper, SCOPED to https://github.com on purpose. An unscoped `credential.helper` makes git
#    offer it to every host it is pointed at — including whatever URL a cloned repo names in its
#    .gitmodules, which is an attacker-chosen string. The helper refuses non-GitHub hosts on its own
#    too; both layers are proven in git-credential.test.ts, one by driving real git. This is the
#    outer of the two.
# 2. An identity, because git refuses to guess one and an agent that cannot commit cannot open the PR
#    that repo-dev-v1 exists for. This is the App's own bot account (`gh api /users/k8s-broker[bot]`
#    -> id 305576643): a commit an agent pushes is then attributed to the broker's App and linked to
#    that bot by GitHub, not to Arnault. It is a display string — nothing authenticates against it —
#    so if the App is ever replaced, correcting it here is the whole change.
RUN git config --system credential."https://github.com".helper agent-broker \
 && git config --system user.name 'k8s-broker[bot]' \
 && git config --system user.email '305576643+k8s-broker[bot]@users.noreply.github.com'

# `gh`, so an agent can open a PR with the tool it actually reaches for instead of hand-rolling a
# REST call. ERGONOMICS, not security — nothing here defends a boundary. The real binary lives OFF
# PATH; /usr/local/bin/gh (which precedes /usr/bin) is a wrapper that fetches the token through the
# same credential helper git uses and passes it in the environment, never in argv.
#
# Pinned by version AND checksum: this is the one thing in the image fetched from outside the
# registry at build time, and an unpinned `latest` would mean the loge's tooling changes under us
# without a commit. Verified before extraction — a corrupted or swapped tarball must fail the build,
# not land in the image.
ARG GH_VERSION=2.96.0
ARG GH_SHA256=83d5c2ccad5498f58bf6368acb1ab32588cf43ab3a4b1c301bf36328b1c8bd60
RUN curl -fsSL -o /tmp/gh.tgz "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
 && echo "${GH_SHA256}  /tmp/gh.tgz" | sha256sum -c - \
 && mkdir -p /opt/gh \
 && tar -xzf /tmp/gh.tgz -C /opt/gh --strip-components=1 \
 && rm /tmp/gh.tgz \
 && /opt/gh/bin/gh --version
COPY --chmod=0755 image/gh /usr/local/bin/gh
USER node

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/index.js"]
