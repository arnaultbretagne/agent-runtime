{
  "name": "agent-runtime-supervisor",
  "version": "0.1.0",
  "description": "Thin generic supervisor: spawns opaque runtime processes by closed kind, under a PTY (agent-runtime ADR 0001/0002).",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:manager": "node dist/manager.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
