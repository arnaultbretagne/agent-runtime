#!/bin/sh
# git credential helper shim (agent-broker plan P6.4).
#
# Named for git's convention: `credential.helper = agent-broker` makes git look for
# `git-credential-agent-broker` on PATH. That is why this file exists at all — the real helper is
# node, and git wants an executable it can name.
#
# `exec` so the helper IS this process: no shell left holding a pipe, no extra pid, and git's stdin
# and stdout reach the helper untouched (the credential travels on that stdout — it must not pass
# through a shell that could echo, log, or expand it).
exec node /app/dist/loge/git-credential.js "$@"
